{
  "rewrites": [
    { "source": "/download-resume", "destination": "/AngatShah_Resume.pdf" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/download-resume",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"AngatShah_Resume.pdf\""
        },
        {
          "key": "Content-Type",
          "value": "application/pdf"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
